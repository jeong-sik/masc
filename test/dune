; Keep the focused alias above for local evidence capture, and make the default
; test alias run it too. CI asks only for @test/runtest; without this edge the
; PTY suite compiles its TUI dependency but none of its interaction assertions
; execute.
(alias
 (name runtest)
 (deps (alias runtest-test_tui_keyboard_input)))

; The named lanes below are the same suite sliced by scenario family. They
; existed only as local commands, so every assertion in them was dead in CI:
; a PR could "fix" a lane scenario that nothing ever ran (found by the
; #32245 review). One rule per lane keeps a red lane's name in the failure
; output instead of one undifferentiated suite.

(rule
 (alias runtest-test_tui_keyboard_input-cli-base-path)
 (deps
  test_tui_keyboard_input.py
  ../bin/masc_tui.exe)
 (action
  (run
   python3
   %{dep:test_tui_keyboard_input.py}
   %{dep:../bin/masc_tui.exe}
   cli-base-path)))

(alias
 (name runtest)
 (deps (alias runtest-test_tui_keyboard_input-cli-base-path)))

