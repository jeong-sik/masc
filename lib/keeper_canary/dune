(include_subdirs no)

; Provider- and Eio-free logic behind bin/keeper_canary_run.ml: nonce fact
; generation, recall scoring, the evidence JSON schema, and the LLM judge
; prompt/verdict contract. Split out of
; bin/ into its own library so it is unit-testable — bin/ executables in
; this repo are thin CLI entry points; test/ cannot pull modules out of an
; executable's private (modules ...) list, only out of a library. Prompt text
; resolves through the registry at call time, after the caller has bootstrapped
; its configured prompt directory.
(library
 (name keeper_canary)
 (public_name masc.keeper_canary)
 (wrapped false)
 (modules keeper_canary_facts keeper_canary_evidence keeper_canary_judge keeper_canary_failover keeper_canary_serving)
 ; RFC-0071 §3.4 Phase 5 ratchet (warning 4) + unused-value ratchet (warning 32)
 (flags
  (:standard -w +4 -w +33 -w +37))
 (libraries digestif yojson masc.prompt_registry))
