; Media_format — tells which document format a byte string holds, from its
; structure and never from a file name.
;
; It sits below masc so the attachment store and the TUI can link it. It reads
; no file and starts no process.

(include_subdirs no)

(library
 (name masc_media_format)
 (public_name masc.media_format)
 (wrapped false)
 (modules
  document_format
  package_xml
  zip_package_identity
  compound_file
  compound_identity
  media_format)
 (flags
  (:standard -w +4 -w +33 -w +37))
 ; [Document_format.all] is derived, so a new format is in it by construction.
 (preprocess
  (pps ppx_enumerate))
 (libraries xmlm zipc))
