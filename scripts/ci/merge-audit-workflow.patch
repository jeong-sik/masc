   workflow_run:
     workflows: [CI]
     types: [completed]
+  push:
+    branches: [main]
 
 permissions:
   contents: read
   actions: read
   issues: write
+  pull-requests: read
 
 concurrency:
-  group: main-ci-verdict
+  # Event-scoped: a push audit must not queue behind a scheduled-verdict run
+  # (and vice versa); each lane keeps at most one running and one pending.
+  group: main-ci-verdict-${{ github.event_name }}
   cancel-in-progress: false
 
 jobs:
+  merge-audit:
+    name: Audit the merge verdict this push landed with
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    # A push to main is a merge. Branch protection makes the required
+    # contexts report, but it does not make them conclude: PR #30463 merged
+    # on 2026-08-25 with CI Gate=CANCELLED, Build and Test=SKIPPED and
+    # Dashboard=CANCELLED, and main then ran red for 64 minutes before
+    # anything said so. This job looks at what the merge actually carried.
+    # It cannot block the push -- the merge already happened -- so on an
+    # unfinished verdict it files a tracking issue immediately and marks
+    # itself red, surfacing the window in minutes instead of on the next
+    # 30-minute timer.
+    if: ${{ github.event_name == 'push' }}
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v7
+
+      - name: Audit the PR-head verdicts this merge carried
+        env:
+          GH_TOKEN: ${{ github.token }}
+          MERGE_AUDIT_CONTEXTS: ${{ vars.MERGE_AUDIT_CONTEXTS || 'CI Gate' }}
+        run: |
+          set -euo pipefail
+
+          # CI runs on PR heads, not on the merge commit (main is on a
+          # 30-minute timer), so the verdicts a merge carries live on the
+          # associated PR's head SHA. Direct pushes with no PR have no PR
+          # verdicts to audit; the scheduled verdict still covers main.
+          pr_head="$(gh api "repos/${GITHUB_REPOSITORY}/commits/${GITHUB_SHA}/pulls" \
+            --jq '.[0].head.sha // empty' || true)"
+          if [ -z "${pr_head}" ]; then
+            echo "::notice::no associated PR for ${GITHUB_SHA}; nothing to audit (scheduled verdict still covers main)"
+            exit 0
+          fi
+          echo "merge ${GITHUB_SHA:0:10} carries PR head ${pr_head:0:10}"
+
+          audit_json="${RUNNER_TEMP}/merge-audit.json"
+
+          set +e
+          python3 scripts/ci/check-merge-audit.py \
+            --sha "${pr_head}" \
+            --contexts "${MERGE_AUDIT_CONTEXTS}" \
+            --json-out "${audit_json}"
+          audit_rc=$?
+          set -e
+
+          if [ "${audit_rc}" -eq 0 ]; then
+            echo "merge audit: clean, nothing to file"
+            exit 0
+          fi
+          if [ "${audit_rc}" -ne 1 ]; then
+            echo "::error title=merge audit could not run::exit ${audit_rc} -- see log above"
+            exit 1
+          fi
+
+          cat "${audit_json}"
+          issue_body="$(python3 - "${audit_json}" <<'PY'
+          import json, sys
+
+          with open(sys.argv[1], encoding="utf-8") as handle:
+              audit = json.load(handle)
+
+          lines = [
+              "A push to main landed while a required check carried no success",
+              "conclusion (CANCELLED / SKIPPED / absent) -- the PR #30463 shape.",
+              "",
+              f"Commit: `{audit['sha']}` (PR head whose verdicts the merge carried)",
+              "",
+              "Offending checks (newest conclusion per name):",
+          ]
+          for entry in audit["offending"]:
+              lines.append(f"- `{entry['context']}` — **{entry['conclusion']}**: {entry['explanation']}")
+          lines += [
+              "",
+              "Filed automatically by the merge-audit job (task-377). The merge",
+              "cannot be undone; this issue exists so the broken window is seen",
+              "in minutes, not on the next scheduled verdict.",
+              "",
+              "```masc-triage",
+              "kind: defect",
+              "area: ci",
+              "impact: internal",
+              "must-do: true",
+              "```",
+          ]
+          print("\n".join(lines))
+          PY
+          )"
+          # The label may not exist on a fresh repository; a labelling
+          # failure must not lose the issue itself.
+          gh issue create \
+            --repo "${GITHUB_REPOSITORY}" \
+            --title "[merge-audit] merge landed with unfinished required-check verdicts (${GITHUB_SHA:0:10})" \
+            --body "${issue_body}" \
+            --label merge-audit \
+          || gh issue create \
+            --repo "${GITHUB_REPOSITORY}" \
+            --title "[merge-audit] merge landed with unfinished required-check verdicts (${GITHUB_SHA:0:10})" \
+            --body "${issue_body}" \
+          || echo "::warning::merge audit found unfinished verdicts but could not file the issue"
+
+          # Red on purpose: this push merged without verdicts, and the job
+          # result is the first thing anyone reading the commit sees.
+          exit 1
+
   verdict:
     name: Report the scheduled main verdict
     runs-on: ubuntu-latest
