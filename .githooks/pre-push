#!/usr/bin/env bash
# RFC-0209 follow-up: refuse push that introduces dune build trace dumps.
#
# Triggered by git push (core.hooksPath=.githooks).  Every commit the push
# adds is checked against the advertised remote tip and the destination
# remote's tracking refs. A merge is checked for paths changed relative to
# every parent, so an inherited dump is covered by its original commit.
# A newly added or changed path matching the leak patterns refuses the push.
# Renames count as additions and deletions pass, so a pushed dump can be removed.
#
# Leak source: DUNE_BUILD_DIR=_build-<suffix> dune build emits
# _build-<suffix>/trace.csexp containing the full process environment
# (including active API keys for Supabase, RunPod, OpenAI, etc.).
# This is a dune build-trace footgun, not a dune bug; we block the
# patterns explicitly.

set -euo pipefail

LEAK_FOUND=0
remote_name=$1

while read -r local_ref local_sha remote_ref remote_sha; do
  # A branch deletion adds no commit (githooks(5)).
  if [[ "$local_ref" == '(delete)' ]]; then
    continue
  fi
  case "$remote_ref" in
    refs/heads/*) ;;
    *) continue ;;
  esac
  known_remote_history=(--not "--remotes=$remote_name")
  # A new branch has an all-zero tip. If an existing tip is missing locally,
  # keep the conservative scan using only the destination's tracking refs.
  if [[ "$remote_sha" == *[!0]* ]] && git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    known_remote_history+=("$remote_sha")
  fi
  # Per-commit paths rather than one diff of the two tips: a branch's first
  # push has no remote tip, and a dump that a later commit deletes is gone
  # from the tip diff but still in the pushed history.
  # --diff-merges needs git 2.31 or later. On an older git, git log fails
  # and the push is refused below.
  if ! added=$(git log --format= --name-only --no-renames --diff-filter=d \
                 --diff-merges=combined "$local_sha" "${known_remote_history[@]}" --); then
    echo "pre-push: REFUSING push of $remote_ref"
    echo "  Reason: could not list the commits this push adds (git log failed)"
    LEAK_FOUND=1
    continue
  fi
  if printf '%s\n' "$added" | grep -E '^(trace\.csexp$|_build-[^/]*/)'; then
    echo "pre-push: REFUSING push of $remote_ref"
    echo "  Reason: a new commit adds or changes trace.csexp or a _build-*/ path"
    echo "  Strip with: git rm -r --cached <path>, then rewrite the commit that added it"
    echo "  Or: ensure the path is ignored by .gitignore (pattern: _build-*/ or trace.csexp)"
    LEAK_FOUND=1
  fi
done

exit "$LEAK_FOUND"
