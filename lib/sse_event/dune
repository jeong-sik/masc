(include_subdirs no)

; Typed SSE event payloads: the atd-generated types and JSON readers and
; writers. Production lib (no (optional)).

(library
 (name sse_event)
 (public_name masc.sse_event)
 (flags
  (:standard -w +4 -w +33))
 (libraries yojson atdgen-runtime))

(rule
 (targets sse_event_t.ml sse_event_t.mli)
 (deps sse_event.atd)
 (action
  (run atdgen -t %{deps})))

(rule
 (targets sse_event_j.ml sse_event_j.mli)
 (deps sse_event.atd)
 (action
  (run atdgen -j -j-std %{deps})))
