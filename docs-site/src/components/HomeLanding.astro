---
interface Props {
  lang?: 'en' | 'ko';
}

const { lang = 'en' } = Astro.props;
const isKo = lang === 'ko';

const t = {
  tagline: isKo
    ? "독립된 Keeper 에이전트와 IDE(Claude Code, Cursor)를 연결하는 로컬 퍼스트 하네스"
    : "Local-first shared workspace and execution harness for autonomous coding agents.",
  copyCommand: "./quickstart.sh",

  // Tabs for real screenshot
  tab1: isKo ? "1. 개요 (Overview)" : "1. Overview",
  tab2: isKo ? "2. 키퍼 (Keepers)" : "2. Keepers",
  tab3: isKo ? "3. 런타임 (Lanes)" : "3. Lanes",
  tab4: isKo ? "5. 승인 (Approvals)" : "5. Approvals",
  tab5: isKo ? "6. 활동 (Activity)" : "6. Activity",
  screenCaption: isKo 
    ? "실제 터미널 런타임 캡처 (masc-tui · 2026-09-04 실측 133×28)" 
    : "Actual terminal capture from masc-tui (2026-09-04 live runtime 133×28)",

  // Invariants
  invariantsTag: isKo ? "핵심 불변식" : "CORE INVARIANTS",
  invariantsTitle: isKo ? "4대 런타임 불변식" : "Four Runtime Invariants",

  card1Title: isKo ? "파일 락 기반 작업 선점 (Claim)" : "File-Locked Task Claiming",
  card1Desc: isKo
    ? ".masc/ 작업 저장소의 파일 락을 통해 Task 소유권을 확정하여 복수 에이전트 간 중복 작업을 분할합니다."
    : "Tasks are exclusively claimed via .masc/ file locks to coordinate work partitions across multiple agents.",

  card2Title: isKo ? "단일 MCP 게이트웨이" : "Unified MCP Gateway",
  card2Desc: isKo
    ? "Claude Code, Cursor 등 외부 도구가 HTTP SSE 엔드포인트(:8935/mcp)로 연결되며 masc mcp-config로 즉시 설정합니다."
    : "Exposes HTTP SSE endpoint (:8935/mcp) for external tools with instant masc mcp-config generation.",

  card3Title: isKo ? "인과 장기 기억 (Memory OS)" : "Causal Memory OS",
  card3Desc: isKo
    ? "트리거, 의사결정, 결과 노드를 인과 그래프로 영속화하여 세션 종료 후에도 작업 맥락을 유지합니다."
    : "Persists trigger-decision-outcome graph nodes across sessions without loss of context.",

  card4Title: isKo ? "샌드박스 격리 & 오퍼레이터 승인" : "Sandbox Isolation & Operator Approvals",
  card4Desc: isKo
    ? "도구 실행을 Docker, MicroVM(apple_container), Remote SSH로 격리하고 고위험 명령은 Approvals 큐에서 승인을 대기합니다."
    : "Confines tool execution within Docker, MicroVM, or Remote SSH, pausing high-risk mutations in Approvals.",

  // Quickstart
  quickTag: isKo ? "빠른 시작" : "QUICKSTART",
  quickTitle: isKo ? "3단계로 즉시 실행" : "Up and Running in 3 Steps",
  step1: isKo ? "1. 작업 공간 서버 기동" : "1. Launch Workspace Server",
  step1Desc: isKo ? "스크립트로 .masc 디렉터리를 초기화하고 포트 8935 서버를 기동합니다." : "Initializes local .masc state and starts server on port 8935.",
  step2: isKo ? "2. 터미널 조종석 접속" : "2. Launch Terminal UI",
  step2Desc: isKo ? "masc-tui로 에이전트 궤적, 툴 트리, 작업 상태를 실시간 관측합니다." : "Supervises live agent trajectories, tool calls, and state in masc-tui.",
  step3: isKo ? "3. MCP 클라이언트 연동" : "3. Connect MCP Client",
  step3Desc: isKo ? "원클릭으로 Claude Code, Cursor용 베어러 토큰 및 설정 블록을 생성합니다." : "Generates ready configuration snippet with long-lived worker bearer.",

  // Quick links
  docsTitle: isKo ? "문서 둘러보기" : "Documentation Matrix",
  docGetStarted: isKo ? "시작하기" : "Getting Started",
  docGetStartedDesc: isKo ? "개요, 빠른 시작, FAQ" : "Overview, Quickstart, FAQ",
  docGuides: isKo ? "사용 가이드" : "User Guides",
  docGuidesDesc: isKo ? "터미널 UI(TUI), Keeper 구동, MCP 연동" : "Terminal UI, Keepers, MCP clients",
  docOps: isKo ? "운영 가이드" : "Operations",
  docOpsDesc: isKo ? "로컬 Llama 연결, Docker 샌드박스, 문제 해결" : "Local models, Docker sandbox, troubleshooting",
  docArch: isKo ? "핵심 원리 & 설계 결정" : "Architecture & Decisions",
  docArchDesc: isKo ? "헌법 불변식, 장기 기억, 다중 모델 심의" : "Invariants, Memory OS, Multi-model deliberation",
};
---

<div class="eng-root">
  {/* TOP COMPACT MASTHEAD */}
  <header class="masthead">
    <div class="masthead-left">
      <div class="brand-row">
        <span class="brand-name">MASC</span>
        <span class="brand-ver">v0.31.0</span>
        <span class="brand-sep">/</span>
        <span class="brand-tagline">{t.tagline}</span>
      </div>
    </div>
    <div class="masthead-right">
      <div class="quick-cmd" id="copy-install-cmd" title="Click to copy">
        <span class="cmd-dollar">$</span>
        <code class="cmd-code">{t.copyCommand}</code>
        <span class="copy-badge">Copy</span>
      </div>
      <a href={isKo ? "/ko/getting-started/quickstart/" : "/getting-started/quickstart/"} class="nav-link-btn">
        {isKo ? "빠른 시작 →" : "Quickstart →"}
      </a>
      <a href="https://github.com/jeong-sik/masc" target="_blank" rel="noreferrer" class="nav-link-dim">
        GitHub ↗
      </a>
    </div>
  </header>

  {/* REAL TERMINAL CAPTURE SHOWCASE (NO FAKE CSS TERMINAL) */}
  <section class="tui-showcase-section">
    <div class="tui-tab-bar">
      <div class="tui-tabs">
        <button class="tui-tab active" data-img="/01-overview.png">{t.tab1}</button>
        <button class="tui-tab" data-img="/02-keepers.png">{t.tab2}</button>
        <button class="tui-tab" data-img="/03-lanes.png">{t.tab3}</button>
        <button class="tui-tab" data-img="/05-approvals.png">{t.tab4}</button>
        <button class="tui-tab" data-img="/06-activity.png">{t.tab5}</button>
      </div>
      <span class="tui-caption">{t.screenCaption}</span>
    </div>

    <div class="tui-frame">
      <img 
        id="tui-active-img" 
        src="/01-overview.png" 
        alt="MASC Terminal UI Live Screenshot" 
        width="1920" 
        height="1080" 
        loading="eager"
      />
    </div>
  </section>

  {/* 4 HARDENED INVARIANTS */}
  <section class="sec-block">
    <div class="sec-hdr">
      <span class="sec-tag">{t.invariantsTag}</span>
      <h2 class="sec-title">{t.invariantsTitle}</h2>
    </div>

    <div class="inv-grid">
      <div class="inv-card">
        <div class="inv-head">
          <span class="inv-idx">01</span>
          <h3 class="inv-name">{t.card1Title}</h3>
        </div>
        <p class="inv-body">{t.card1Desc}</p>
        <pre class="inv-code"><code><span class="c-kw">match</span> Workspace_task.claim_task config ~agent_name ~task_id <span class="c-kw">with</span>
| <span class="c-ok">Ok</span> task -&gt; execute_turn ~task ()
| <span class="c-err">Error</span> (Held_by_other &#123; owner; _ &#125;) -&gt; yield_to_peer ~owner</code></pre>
      </div>

      <div class="inv-card">
        <div class="inv-head">
          <span class="inv-idx">02</span>
          <h3 class="inv-name">{t.card2Title}</h3>
        </div>
        <p class="inv-body">{t.card2Desc}</p>
        <div class="mcp-tags">
          <span class="tag-item">Claude Code</span>
          <span class="tag-item">Cursor IDE</span>
          <span class="tag-item">Codex</span>
          <span class="tag-item">Windsurf</span>
        </div>
      </div>

      <div class="inv-card">
        <div class="inv-head">
          <span class="inv-idx">03</span>
          <h3 class="inv-name">{t.card3Title}</h3>
        </div>
        <p class="inv-body">{t.card3Desc}</p>
        <div class="graph-pill">
          <span>Trigger</span> &rarr; <span class="pill-act">Decision</span> &rarr; <span>Outcome</span>
        </div>
      </div>

      <div class="inv-card">
        <div class="inv-head">
          <span class="inv-idx">04</span>
          <h3 class="inv-name">{t.card4Title}</h3>
        </div>
        <p class="inv-body">{t.card4Desc}</p>
        <div class="gate-strip">
          <span class="gate-lbl">APPROVAL QUEUE</span>
          <code>git push origin main --force</code>
          <span class="gate-act">Paused for operator</span>
        </div>
      </div>
    </div>
  </section>

  {/* 3 QUICK COMMANDS */}
  <section class="sec-block">
    <div class="sec-hdr">
      <span class="sec-tag">{t.quickTag}</span>
      <h2 class="sec-title">{t.quickTitle}</h2>
    </div>

    <div class="quick-grid">
      <div class="q-card">
        <div class="q-num">1</div>
        <div class="q-content">
          <h4>{t.step1}</h4>
          <p>{t.step1Desc}</p>
          <pre><code>$ ./quickstart.sh</code></pre>
        </div>
      </div>
      <div class="q-card">
        <div class="q-num">2</div>
        <div class="q-content">
          <h4>{t.step2}</h4>
          <p>{t.step2Desc}</p>
          <pre><code>$ masc-tui</code></pre>
        </div>
      </div>
      <div class="q-card">
        <div class="q-num">3</div>
        <div class="q-content">
          <h4>{t.step3}</h4>
          <p>{t.step3Desc}</p>
          <pre><code>$ masc mcp-config --client claude-desktop</code></pre>
        </div>
      </div>
    </div>
  </section>


  {/* DOCUMENTATION MATRIX */}
  <section class="sec-block">
    <div class="sec-hdr">
      <span class="sec-tag">INDEX</span>
      <h2 class="sec-title">{t.docsTitle}</h2>
    </div>

    <div class="doc-matrix">
      <a href={isKo ? "/ko/getting-started/overview/" : "/getting-started/overview/"} class="doc-card">
        <span class="doc-card-tag">{t.docGetStarted} &rarr;</span>
        <span class="doc-card-desc">{t.docGetStartedDesc}</span>
      </a>
      <a href={isKo ? "/ko/guides/tui/" : "/guides/tui/"} class="doc-card">
        <span class="doc-card-tag">{t.docGuides} &rarr;</span>
        <span class="doc-card-desc">{t.docGuidesDesc}</span>
      </a>
      <a href={isKo ? "/ko/runbooks/llama-server/" : "/runbooks/llama-server/"} class="doc-card">
        <span class="doc-card-tag">{t.docOps} &rarr;</span>
        <span class="doc-card-desc">{t.docOpsDesc}</span>
      </a>
      <a href={isKo ? "/ko/architecture/constitution/" : "/architecture/constitution/"} class="doc-card">
        <span class="doc-card-tag">{t.docArch} &rarr;</span>
        <span class="doc-card-desc">{t.docArchDesc}</span>
      </a>
    </div>
  </section>
</div>

<script>
  // Real Screenshot Tab Switching
  const tabs = document.querySelectorAll('.tui-tab');
  const activeImg = document.getElementById('tui-active-img') as HTMLImageElement;

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');

      const imgSrc = tab.getAttribute('data-img');
      if (activeImg && imgSrc) {
        activeImg.src = imgSrc;
      }
    });
  });

  // Copy to Clipboard
  const copyBox = document.getElementById('copy-install-cmd');
  if (copyBox) {
    copyBox.addEventListener('click', async () => {
      const code = copyBox.querySelector('.cmd-code')?.textContent || '';
      try {
        await navigator.clipboard.writeText(code);
        const badge = copyBox.querySelector('.copy-badge');
        if (badge) {
          badge.textContent = 'Copied!';
          setTimeout(() => { badge.textContent = 'Copy'; }, 2000);
        }
      } catch (err) {
        console.warn('Copy failed', err);
      }
    });
  }
</script>

<style>
  .eng-root {
    max-width: 1060px;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
    color: #f0e9dc;
    font-family: var(--sl-font-system, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
  }

  /* TOP COMPACT MASTHEAD */
  .masthead {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #221f1a;
    margin-bottom: 2rem;
  }

  .brand-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.875rem;
  }

  .brand-name {
    font-family: var(--sl-font-mono, monospace);
    font-weight: 800;
    font-size: 1.125rem;
    color: #d4a14a;
    letter-spacing: 0.05em;
  }

  .brand-ver {
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.75rem;
    background: #1a1815;
    border: 1px solid #2a2520;
    color: #9c9589;
    padding: 1px 6px;
    border-radius: 3px;
  }

  .brand-sep {
    color: #3b352e;
  }

  .brand-tagline {
    color: #9c9589;
  }

  .masthead-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .quick-cmd {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: #141210;
    border: 1px solid #2a2520;
    border-radius: 4px;
    padding: 0.35rem 0.65rem;
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.8125rem;
    cursor: pointer;
    transition: border-color 0.15s;
  }

  .quick-cmd:hover {
    border-color: #d4a14a;
  }

  .cmd-dollar {
    color: #d4a14a;
    user-select: none;
  }

  .cmd-code {
    color: #f0e9dc;
    background: transparent !important;
    padding: 0 !important;
    border: none !important;
  }

  .copy-badge {
    font-size: 0.6875rem;
    color: #6e675d;
    margin-left: 0.3rem;
  }

  .nav-link-btn {
    background: #211e1a;
    color: #d4a14a !important;
    border: 1px solid #332d24;
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 0.4rem 0.75rem;
    border-radius: 4px;
    text-decoration: none !important;
    transition: all 0.15s;
  }

  .nav-link-btn:hover {
    background: #2b2721;
    border-color: #d4a14a;
  }

  .nav-link-dim {
    color: #6e675d !important;
    font-size: 0.8125rem;
    text-decoration: none !important;
  }

  .nav-link-dim:hover {
    color: #f0e9dc !important;
  }

  /* REAL TUI SHOWCASE */
  .tui-showcase-section {
    margin-bottom: 3.5rem;
  }

  .tui-tab-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .tui-tabs {
    display: flex;
    gap: 0.4rem;
  }

  .tui-tab {
    background: #141210;
    border: 1px solid #2a2520;
    color: #9c9589;
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.75rem;
    padding: 0.35rem 0.75rem;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s;
  }

  .tui-tab:hover {
    color: #f0e9dc;
    border-color: #3b352e;
  }

  .tui-tab.active {
    background: #211e1a;
    border-color: #d4a14a;
    color: #d4a14a;
    font-weight: 600;
  }

  .tui-caption {
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.6875rem;
    color: #6e675d;
  }

  .tui-frame {
    background: #000;
    border: 1px solid #2a2520;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6);
  }

  .tui-frame img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  /* SECTION BLOCKS */
  .sec-block {
    margin-bottom: 3.5rem;
  }

  .sec-hdr {
    margin-bottom: 1.5rem;
  }

  .sec-tag {
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.6875rem;
    color: #d4a14a;
    font-weight: 700;
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 0.35rem;
  }

  .sec-title {
    font-size: 1.375rem;
    font-weight: 700;
    color: #f0e9dc;
    margin: 0;
  }

  /* INVARIANTS GRID */
  .inv-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 768px) {
    .inv-grid {
      grid-template-columns: 1fr;
    }
  }

  .inv-card {
    background: #100f0c;
    border: 1px solid #221f1a;
    border-radius: 6px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
  }

  .inv-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
  }

  .inv-idx {
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.75rem;
    color: #d4a14a;
    font-weight: 700;
  }

  .inv-name {
    font-size: 1rem;
    font-weight: 700;
    color: #f0e9dc;
    margin: 0;
  }

  .inv-body {
    font-size: 0.8125rem;
    color: #9c9589;
    line-height: 1.55;
    margin: 0 0 1rem;
  }

  .inv-code {
    margin-top: auto;
    background: #080706 !important;
    border: 1px solid #1f1d19;
    border-radius: 4px;
    padding: 0.6rem !important;
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.6875rem;
    line-height: 1.4;
  }

  .c-kw { color: #c678dd; }
  .c-str { color: #98c379; }
  .c-num { color: #d19a66; }
  .c-ok { color: #e5c07b; }
  .c-err { color: #e06c75; }

  .mcp-tags {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag-item {
    background: #141210;
    border: 1px solid #221f1a;
    color: #d4a14a;
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.6875rem;
    padding: 2px 7px;
    border-radius: 3px;
  }

  .graph-pill {
    margin-top: auto;
    background: #080706;
    border: 1px solid #1f1d19;
    padding: 0.4rem 0.6rem;
    border-radius: 4px;
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.75rem;
    color: #6e675d;
  }

  .pill-act {
    color: #d4a14a;
    font-weight: 600;
  }

  .gate-strip {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: #080706;
    border: 1px solid rgba(255, 95, 86, 0.2);
    padding: 0.4rem 0.6rem;
    border-radius: 4px;
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.6875rem;
  }

  .gate-lbl {
    color: #ff5f56;
    font-weight: 700;
  }

  .gate-act {
    margin-left: auto;
    color: #ffbd2e;
  }

  /* QUICK COMMANDS */
  .quick-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  @media (max-width: 768px) {
    .quick-grid {
      grid-template-columns: 1fr;
    }
  }

  .q-card {
    background: #100f0c;
    border: 1px solid #221f1a;
    border-radius: 6px;
    padding: 1.25rem;
    display: flex;
    gap: 0.9rem;
  }

  .q-num {
    font-family: var(--sl-font-mono, monospace);
    font-size: 1.25rem;
    font-weight: 800;
    color: #332d24;
    line-height: 1;
  }

  .q-content h4 {
    font-size: 0.875rem;
    font-weight: 700;
    color: #f0e9dc;
    margin: 0 0 0.35rem;
  }

  .q-content p {
    font-size: 0.75rem;
    color: #9c9589;
    margin: 0 0 0.75rem;
    line-height: 1.4;
  }

  .q-content pre {
    background: #080706 !important;
    border: 1px solid #1f1d19;
    border-radius: 4px;
    padding: 0.4rem 0.6rem !important;
    font-size: 0.75rem;
    color: #d4a14a;
    margin: 0;
  }

  /* DOC MATRIX */
  .doc-matrix {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
  }

  @media (max-width: 900px) {
    .doc-matrix {
      grid-template-columns: 1fr 1fr;
    }
  }

  .doc-card {
    background: #100f0c;
    border: 1px solid #221f1a;
