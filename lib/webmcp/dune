(include_subdirs no)

; The node bridge's SSOT is dashboard/scripts/webmcp-bridge.mjs (also runnable
; directly by operators and Yolo keepers). Embedding it at build time means a
; deployed binary never depends on a repo checkout or a separately shipped
; asset — the stale-asset failure class cannot occur for this surface.
(rule
 (targets webmcp_bridge_source.ml)
 (deps ../../dashboard/scripts/webmcp-bridge.mjs)
 (action
  (with-stdout-to
   webmcp_bridge_source.ml
   (progn
    (echo "(* Generated by dune from dashboard/scripts/webmcp-bridge.mjs — do not edit. *)\n")
    (echo "let source = {ext|")
    (cat ../../dashboard/scripts/webmcp-bridge.mjs)
    (echo "|ext}\n")))))

(library
 (name masc_webmcp)
 (public_name masc.masc_webmcp)
 (wrapped false)
 (modules webmcp_bridge webmcp_bridge_source)
 (flags
  (:standard -w +4 -w +33 -w +37))
 ; eio is already linked transitively through masc_process; naming it here is what
 ; lets this library reference Eio.Cancel.Cancelled, which #37372 requires of any
 ; catch-all around an Eio call -- and Process_eio.run_argv is one.
 (libraries masc_process yojson unix threads eio))
