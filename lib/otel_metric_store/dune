(include_subdirs no)

(library
 (name otel_metric_store)
 (public_name masc.otel_metric_store)
 (wrapped false)
 (modules
  otel_builtin_metric_names
  otel_core_metric_names
  otel_identity_metric_names
  otel_metric_key
  otel_metric_names
  otel_metric_store_core
  otel_agent_core_metric_names
  otel_policy_metric_names
  otel_runtime_metric_names
  otel_transport_metric_names)
 (flags
  (:standard -w +4 -w +33))
 ; masc_cancel_safe: RFC-0106 SSOT for the one exception this store must not
 ; swallow. It depends on eio alone, so it adds no cycle to this leaf library.
 (libraries eio mtime mtime.clock masc_log masc_cancel_safe))
