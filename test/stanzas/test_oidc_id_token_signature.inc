; Signature and expiry checks of OIDC ID tokens against fixed vectors, and the
; exchange of a Google login with the transport answered by the test. The
; vectors module is generated by scripts/gen-oidc-test-vectors.py and is shared
; by both tests, which is why they are one stanza.

(tests
 (names test_oidc_id_token_signature test_oidc_google_exchange)
 (modules test_oidc_id_token_signature test_oidc_google_exchange oidc_id_token_vectors)
 (action (run %{test}))
 (libraries masc_test_deps ptime))
