;; Lane CLI slot probe.  A declared [cli_slots] runtime is the one transport an
;; operator cannot reach with curl: masc admits the subscription, spawns the
;; client, carries the lane schema as prompt text and parses the reply with no
;; fence stripping.  This runs Keeper_lane_cli_oneshot itself so a measurement
;; describes what the lane would actually receive.
(executable
 (name masc_lane_cli_probe)
 (modules masc_lane_cli_probe)
 (public_name masc-lane-cli-probe)
 (package masc)
 (libraries
  masc
  masc.prompt_registry
  masc.server
  masc.runtime
  masc.fusion_core
  masc_eio_context
  agent_core
  unix
  yojson
  eio
  eio_main))

