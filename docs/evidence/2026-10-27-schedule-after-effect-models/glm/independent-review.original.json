  "finding": {
    "severity": "P2",
    "title": "Exact scheduled work request disappears from non-Anthropic tool-round input",
    "trigger": "An admitted Schedule_due turn runs a discovery or other tool before copying/retrieving its original work request into durable history.",
    "source_path": [
      {
        "file": "lib/keeper/keeper_unified_prompt.ml",
        "line": 1864,
        "fact": "Scheduled payload is rendered into the Scheduled_automation world layer."
      },
      {
