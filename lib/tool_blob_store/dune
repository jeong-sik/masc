; Content-addressed blob store for tool outputs.
;
; This store keeps SHA256-addressed bytes blobs, sharded by sha[0..1].
;
; Used by tool_bridge to externalize large tool outputs and by the keeper
; explicit artifact consumers resolve refs without expanding LLM history.

(include_subdirs no)

(library
 (name masc_tool_blob_store)
 (public_name masc.masc_tool_blob_store)
 (wrapped false)
 (modules tool_blob_store tool_output tool_blob_maintenance)
 ; RFC-0071 §3.4 Phase 5 ratchet (warning 4) + unused-value ratchet (warning 32)
 (flags
  (:standard -w +4 -w +33 -w +37))
 (libraries digestif digestif.c unix yojson fs_compat masc_core))
