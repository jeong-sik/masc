#!/usr/bin/env bash
# RFC-0209 follow-up: refuse push that introduces dune build trace dumps.
#
# Triggered by git push (core.hooksPath=.githooks).  Every commit the push
# adds -- one no remote-tracking ref reaches yet -- is read, a merge commit
# against its first parent.  If one of them touches a path that matches
# the leak patterns other than by deleting it, the push is refused with a
# non-zero exit before any refs are written.  Renames count as an add of
# the new path, so no blob is compared.  A commit that only deletes such a
# path passes, so a pushed dump can be removed.
#
# Leak source: DUNE_BUILD_DIR=_build-<suffix> dune build emits
# _build-<suffix>/trace.csexp containing the full process environment
# (including active API keys for Supabase, RunPod, OpenAI, etc.).
# This is a dune build-trace footgun, not a dune bug; we block the
# patterns explicitly.

set -euo pipefail

LEAK_FOUND=0

while read -r local_ref local_sha _remote_ref _remote_sha; do
  case "$local_ref" in
    refs/heads/*) ;;
    *) continue ;;
  esac
  # Per-commit paths rather than one diff of the two tips: a branch's first
  # push has no remote tip, and a dump that a later commit deletes is gone
  # from the tip diff but still in the pushed history.
  if ! added=$(git log --format= --name-only --no-renames --diff-filter=d \
                 --diff-merges=first-parent "$local_sha" --not --remotes --); then
    echo "pre-push: REFUSING push of $local_ref"
    echo "  Reason: could not list the commits this push adds (git log failed)"
    LEAK_FOUND=1
    continue
  fi
  if printf '%s\n' "$added" | grep -E '^(trace\.csexp$|_build-[^/]*/)'; then
    echo "pre-push: REFUSING push of $local_ref"
    echo "  Reason: a commit not yet on any remote adds trace.csexp or a _build-*/ path"
    echo "  Strip with: git rm -r --cached <path>, then rewrite the commit that added it"
    echo "  Or: ensure the path is ignored by .gitignore (pattern: _build-*/ or trace.csexp)"
    LEAK_FOUND=1
  fi
done

exit "$LEAK_FOUND"
