(** Protected original-operation admission and launch-intent storage.

    Reuses Fs_compat's capability-relative exclusive/replace publication and
    durable recovery obligations. A stable per-job flock never waits for a
    running job or another owner. No subprocess is launched by this module.

    The trusted service supplies its operator-owned route/owner and intended
    payload UID, never values from a Start request. This primitive requires a
    distinct non-root payload UID. It does not certify that a future child
    actually dropped credentials or applied a sandbox. Root payloads still
    require a measured namespace/capability boundary in the supervisor; they
    must not be called supported by weakening this check. *)
module P = Endpoint_job_protocol

type t
type record
type launch_intent
type storage
type unlaunched

type protection_refusal =
  | Payload_is_controller
  | Payload_is_root
  | Invalid_payload_uid
  | Invalid_owner
  | Invalid_root_path
  | Root_not_private
  | Root_owner_mismatch
  | Unsafe_ancestor
  | Root_identity_changed

type error =
  | Protection_refused of protection_refusal
  | Authority_unavailable of string
  | Publication_failed of Fs_compat.capability_write_error
  | Recovery_unavailable of string
  | Lock_failed of File_lock_eio.durable_lock_error
  | Commit_unconfirmed of string
  | Busy
  | Binding_mismatch
  | Invalid_request of P.codec_error
  | Execution_identity_changed
  | Endpoint_replaced
  | Missing_original
  | Admission_incomplete
  | Unsupported_version of { expected : int; actual : int }
  | Corrupt_original of string
  | Launch_already_requested
  | Launch_cancelled
  | Launch_intent_spent
  | Stale_record
  | Cleanup_failed of { primary : error option; cause : File_lock_eio.durable_lock_error }

val error_to_string : error -> string

val open_registry :
  sw:Eio.Switch.t -> fs:Eio.Fs.dir_ty Eio.Path.t -> root_path:string ->
  route:P.route -> owner:P.owner -> payload_uid:int -> (t, error) result
(** The explicit root must already exist, be controller-owned mode0700 and
    resolve through root/controller-owned protected ancestors. Sticky writable
    ancestors are permitted only with trusted ownership. The root capability
    and physical identity stay pinned to [sw]. The original root spelling is
    not used after resolution. No Keeper workspace is used as a fallback.
    The caller must keep [sw] alive for every operation. *)

val admit :
  t -> new_admission_id:P.Id.t -> binding:P.binding -> spec:P.spec ->
  (record, error) result
(** Commit a separate original claim before preparing the private job
    directory. Large original input is published under its own job capability,
    outside the shared registry-parent mutation lease; Ready requires the
    complete original file and its actual parent to be synced. Preparing claims may finish the same original admission;
    a Ready claim with missing job data is refused, never reconstructed.
    An existing Preparing directory is reused only after fresh protected-path
    inspection and the same admission ID and original bytes are verified.
    Existing matching calls return the original admission ID and request.
    [new_admission_id] is freshly generated by the trusted service and used
    only for a genuinely new claim. It is never a model/host-selected old ID
    substituted for missing original authority.

    Admission grants NO launch permission. A future control service must
    durably confirm the returned original admission ID on the host before
    requesting launch. Lost registration replies may repeat admission; after
    host launch intent, reconciliation uses that original ID and never treats
    an absent owner as a new Start. *)

val load : t -> binding:P.binding -> (record, error) result
(** Read the exact original claim, start bytes and head under the stable job
    shared read lock. Readers may overlap; an active exclusive mutation or
    launch still returns [Busy] without waiting. Every record read uses a
    single-link, no-follow descriptor and validates its snapshot before
    returning bytes. Only initial absence is
    reported missing; a failed observed read remains unavailable. Corruption, missing data
    and busy authority stay explicit. Old-boot
    records may be inspected, but cannot issue a new effect permission. *)

val binding : record -> P.binding
val specification : record -> P.spec
val admission_id : record -> P.Id.t
val revision : record -> int64
val payload_uid : record -> int

val launch_record : launch_intent -> record
(** The opaque original captured when this permit was committed, without I/O
    or a new permission. Trusted lifetime owners retain it for original-source
    cancellation and result readback before a native supervisor exists.
    Mutations still refresh and validate that exact source. *)

val refresh : record -> (record, error) result
(** Read only this opaque record's original registry/job and known launch under
    the same nonwaiting shared read lock as [load].
    Legitimate cancellation progress is visible; a replaced registry, job,
    admission, payload or already-known launch never substitutes another one.
    This read grants no launch/signal permission and permits old-boot inspection. *)

val open_storage : sw:Eio.Switch.t -> record -> (storage, error) result
val storage_record : storage -> record
val storage_path : storage -> Eio.Fs.dir_ty Eio.Path.t
(** Open the refreshed original private directory under its own nonwaiting
    shared read lock, pin its physical identity, then release the lock before
    returning.
    The capability belongs to [sw]; immutable result reads/hashing can proceed
    outside the lock and revalidate [storage_record] afterward. No launch
    permit is created or reconstructed. Old-boot terminal data remains readable
    without adopting kernel handles or authorizing effects. *)

type launch_state = Not_requested | Requested of P.Id.t
val launch_state : record -> launch_state

type cancellation_state = No_cancellation | Cancellation_requested
val cancellation_state : record -> cancellation_state

val request_cancel :
  record -> confirmed_admission_id:P.Id.t -> (record, error) result
(** Commit cancellation against the same original admission, input and payload
    identity under its nonwaiting job lock. It may follow launch progress of
    that same operation; it never retargets another admission, job directory
    identity or already-issued launch ID. Once cancelled, the original cannot
    progress into a different launch. Repeated or
    lost-reply requests sync the exact existing claim and its actual parent,
    then revalidate the same original before acknowledging that durable intent
    without advancing it. A failed sync or validation remains an error.
    Source reads and lock admission remain cancellable. An entered claim
    publication and recovery cleanup finish under cancellation protection;
    the exclusive job lock releases before the original cancellation check.
    Cancellation before launch prevents a new launch permit, and cancellation
    after a permit was issued prevents its still-pending callback from starting.
    A currently active bounded launch callback returns [Busy]; no other job is
    waited on. The caller reconciles after that startup settles.

    This is durable intent only, not process termination or result readiness.
    The supervisor must validate its original kernel handle and this current
    intent before any actual signal. This module signals no PID or group. *)

val commit_launch :
  record -> confirmed_admission_id:P.Id.t -> launch_id:P.Id.t ->
  (launch_intent, error) result
(** Compare the entire original owner/head under its own flock and durably
    publish launch intent before returning one opaque process-local permit.
    The confirmation must identify the same original endpoint admission.
    A committed cancellation returns [Launch_cancelled]. An already committed
    launch never returns a fresh permit, including after
    restart/lost reply. Publication/release uncertainty grants no permission.
    The next supervisor layer must reconcile the original paused-child/handle
    rendezvous instead of relaunching such a record. *)

type launch_target = private
  { binding : P.binding; spec : P.spec; admission_id : P.Id.t; launch_id : P.Id.t; payload_uid : int
  ; original_record : record }
(** [original_record] pins the exact registry and committed job/launch state
    revalidated for this permit. Retain it for later original-owner mutations;
    matching coordinates in a caller-supplied registry cannot replace it. *)

type 'a launch_outcome =
  | Not_performed of error
  | Performed of { value : 'a; release_error : File_lock_eio.durable_lock_error option }

val with_launch :
  sw:Eio.Switch.t -> launch_intent ->
  (launch_target -> storage:Eio.Fs.dir_ty Eio.Path.t -> 'a) -> 'a launch_outcome
(** Revalidate the committed original under its job lock, consume the permit
    exactly once, then invoke the bounded launch callback. A cancellation that
    won the same lock returns [Not_performed Launch_cancelled]. Callback exceptions
    and cancellation propagate with the permit spent; they never replay it.
    Cleanup failure preserves the callback's actual result in [Performed].
    [storage] is an opened capability to that exact original private job
    directory, checked against its committed device/inode, owner and mode
    after the permit is consumed and before callback entry. It is owned by
    [sw], which must be the supervisor's per-job resource lifetime, not a
    client request or the global registry lifetime. The callback may retain
    this capability for output/result publication until that switch closes;
    it must not reopen the job by its pathname. No new launch permission is
    conferred by retaining storage. A failed open or identity check consumes
    the permit without invoking the callback; reconcile rather than replay.
    The callback only performs the supervisor's launch rendezvous. It must not
    wait for program completion, hold a global owner lock or reenter a registry
    mutation for this same operation. No PID signalling is authorized here. *)

val settle_cancelled_admission : sw:Eio.Switch.t -> record -> (unlaunched,error) result
(** Prove the same protected original was cancelled before any launch intent
    existed. Under its exclusive nonwaiting job lock, sync the exact existing
    cancellation claim and its actual parent, revalidate its full original
    contents without republication, and retain its exact storage.
    Failed sync or readback grants no proof.
    A known launch refuses this proof, even if it is now cancelled. *)
val retire_cancelled_launch : sw:Eio.Switch.t -> launch_intent -> (unlaunched,error) result
(** Under the original exclusive job lock, sync the exact existing cancellation
    claim and its actual parent and revalidate its full original contents before
    atomically retiring this exact unused process-local permit. Failed sync or
    readback grants no proof and does not retire an unused permit. A permit
    already reserved for callback entry, including an interrupted storage open,
    can never supply this proof. Repeated retirement
    may reopen the same original storage, including after an interrupted open;
    it never re-enables callback entry or issues another launch permission.

    Not_performed Launch_cancelled alone does not supply this authority: that
    check may precede the permit-use check after an earlier callback. *)
val unlaunched_storage : unlaunched -> storage
(** Opaque historical no-callback authority and original storage, not output
    sealing, a physical exit status, result readiness, host consumption or
    cleanup permission. The consumer must durably publish the complete original
    non-start receipt. The retired-permit proof is process-local until that
    publication; a restart cannot reconstruct it from a cancelled known launch.
    Cancelling a proof observer never launches or signals a process. *)
type evidence = Stream_data of P.stream | Stream_seal of P.stream | Terminal_receipt
val evidence_leaf : evidence -> string
(** Canonical original stream/seal/terminal filenames shared with live readers
    and publishers; these names grant no storage or process authority. *)
val publish_unlaunched :
  sw:Eio.Switch.t -> unlaunched ->
  evidence:evidence -> content:string -> (unit,error) result
(** Publish trusted immutable evidence under this opaque proof's exact original
    storage, serializing only its bounded metadata through the original job
    lock. Content comes from trusted codecs, never forwarded controls.
    Admission and source reads remain cancellable. Once entered, the short Fs
    recovery/publication transaction finishes under cancellation protection;
    the job lock releases before checking the original cancellation context.
    Evidence readback and input/output work stay outside that protection.
    Existing evidence is accepted only with identical complete bytes, private
    single-link regular attachment and actual matching file/parent sync and
    readback. No overwrite or claim revision change. Missing authority, changed
    evidence or uncertain durability remains an error. The callback permit stays
    retired after cancellation or failure; this grants neither a process effect
    nor result readiness. [sw] is the independent publisher's resource lifetime.
    Reconciliation concerns only the same immutable evidence, never a relaunch.
    Publication uses the original registry's captured filesystem authority and
    canonical private file mode. A missing stream below an existing seal or
    terminal receipt is refused, and missing seals below a terminal receipt are
    never reconstructed. Interrupted initial publication may complete only its
    original dependencies; a sealed result never becomes a fresh empty spool. *)

module For_testing : sig
  val settle_cancelled_admission :
    ?before_resync_parent:(unit -> unit) -> sw:Eio.Switch.t -> record -> (unlaunched,error) result
  (** Inject immediately before the actual parent fsync, after the matching
      claim file fsync, using the production resync path. This blocking-scope
      hook may raise but must not perform Eio effects. *)
  val retire_cancelled_launch :
    ?before_resync_parent:(unit -> unit) ->
    after_retirement:(unit -> unit) -> sw:Eio.Switch.t -> launch_intent -> (unlaunched,error) result
  (** Interleave after retiring the actual unused permit under its original
      exclusive lock, before opening its storage. Exceptions/cancellation leave
      it retired and release only this lock observer's descriptor.
      [before_resync_parent] has the same blocking-scope contract as above and
      runs before any unused permit is retired. *)
  val refresh : after_lock:(unit -> unit) -> record -> (record, error) result
  (** Interleave after acquiring the actual shared read lock and before reading
      the original. The hook remains cancellable and cannot authorize writes. *)
  val with_launch :
    after_original:(unit -> unit) -> sw:Eio.Switch.t -> launch_intent ->
    (launch_target -> storage:Eio.Fs.dir_ty Eio.Path.t -> 'a) -> 'a launch_outcome
  (** Interleave a real filesystem change after the committed original was
      revalidated and the permit consumed, before opening its storage. *)
  val admit :
    after_claim:(unit -> unit) -> after_missing_job:(unit -> unit) ->
    after_job:(unit -> unit) -> after_original:(unit -> unit) ->
    t -> new_admission_id:P.Id.t -> binding:P.binding -> spec:P.spec ->
    (record, error) result
  (** Interrupt the actual durable boundaries before job publication or before
      Ready promotion. [after_missing_job] interleaves an actual competing
      admission between absence observation and exclusive directory creation.
      Hook exceptions propagate; no alternate store path. *)
  val request_cancel :
    ?before_resync_parent:(unit -> unit) ->
    after_publication:(unit -> unit) -> record -> confirmed_admission_id:P.Id.t ->
    (record, error) result
  (** Interrupt after durable cancellation intent and before its reply.
      [before_resync_parent] runs in the blocking descriptor scope after the
      duplicate's claim fsync and before its actual parent fsync. It may raise
      to exercise sync failure; it must not perform Eio effects. *)
  val commit_launch :
    after_publication:(unit -> unit) -> record ->
    confirmed_admission_id:P.Id.t -> launch_id:P.Id.t -> (launch_intent, error) result
  (** Interrupt after durable launch intent and before a permit is issued. *)
end
