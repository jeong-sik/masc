{
  "name": "masc-dashboard",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.31.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "MASC_DASHBOARD_PROXY_TARGET=http://127.0.0.1:8935 vite",
    "build": "vite build && vite build --config vite.accounts.config.ts",
    "build:report": "BUNDLE_REPORT=1 vite build",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts --no-file-parallelism --maxWorkers=1",
    "test:serial": "pnpm test",
    "test:e2e:keeper-lane": "../scripts/harness_dashboard_keeper_lane_timeline_e2e.sh",
    "test:e2e:internal-agents": "../scripts/harness_dashboard_internal_agents_e2e.sh",
    "test:e2e:queued-stream": "../scripts/harness_dashboard_keeper_queued_stream_e2e.sh",
    "test:e2e:tool-series": "../scripts/harness_dashboard_tool_series_e2e.sh",
    "test:watch": "vitest",
    "tokens:build": "tsx design-system/tokens/build.ts"
  },
  "dependencies": {
    "@leeoniya/ufuzzy": "^1.0.19",
    "@preact/signals": "^2.9.0",
    "@tanstack/preact-table": "^9.3.1",
    "@tanstack/virtual-core": "^3.13.12",
    "diff": "^9.0.0",
    "dompurify": "3.4.17",
    "htm": "^3.1.1",
    "lucide-preact": "^1.14.0",
    "marked": "^18.0.3",
    "preact": "^10.29.1",
    "uplot": "^1.6.32",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@preact/preset-vite": "^2.10.5",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.19.17",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "happy-dom": "^21.0.4",
    "jest-axe": "^9.0.0",
    "jsdom": "^29.1.1",
    "playwright": "1.61.1",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.2"
  },
  "pnpm": {
    "overrides": {
      "lodash-es": "^4.18.1",
      "ws": ">=8.21.0"
    }
  }
}
