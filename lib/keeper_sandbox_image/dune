; The general Keeper sandbox recipe. No dependencies: it is a string and the
; argv that feeds it to docker, so it can be read from a test without a daemon.

(include_subdirs no)

(library
 (name keeper_sandbox_image)
 (public_name masc.keeper_sandbox_image)
 (wrapped false)
 (modules keeper_sandbox_image keeper_sandbox_image_base_recipe)
 (private_modules keeper_sandbox_image_base_recipe))

; sandbox-images/base/Dockerfile is the recipe's only copy. The binary carries
; it as a string so an installed binary can build the image with no checkout.
; A recipe that ever contained the closing delimiter would end the string early
; and the generated module would stop compiling, so that mistake cannot pass
; quietly.

(rule
 (target keeper_sandbox_image_base_recipe.ml)
 (deps ../../sandbox-images/base/Dockerfile)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let dockerfile = {masc_recipe|")
    (cat ../../sandbox-images/base/Dockerfile)
    (echo "|masc_recipe}\n")))))
