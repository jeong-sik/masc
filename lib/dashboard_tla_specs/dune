; Dashboard_tla_specs leaf, kept out of the flat masc mega-library. Mirrors
; the sibling lib/dashboard_eval_feed/dune: the parent lib/dune uses
; (include_subdirs unqualified) which would otherwise absorb this .ml into the
; main masc library; (include_subdirs no) opts out so this directory compiles
; as its own unit. (wrapped false) keeps the bare Dashboard_tla_specs
; identifier visible to callers — the prod consumer
; (lib/server/server_routes_http_routes_verification.ml, in flat masc ns) and
; tests do not rewrite imports.
;
; Outbound deps are all already-extracted sub-libraries or external:
;   Fs_compat              -> fs_compat   (Fs_compat.load_file)
;   Json_util, String_util -> masc_core   (wrapped false)
;   Masc_domain            -> masc_types  (wrapped false; iso8601/now helpers)
;   Yojson, Unix           -> external
; No flat-ns masc module appears below, so a future re-coupling becomes a dune
; cycle that dune build rejects.

(include_subdirs no)

(library
 (name masc_dashboard_tla_specs)
 (public_name masc.dashboard_tla_specs)
 (wrapped false)
 ; Warning 4 (fragile pattern match), 33 (unused open) and 37 (unused constructor) on.
 (flags
  (:standard -w +4 -w +33 -w +37))
 (libraries fs_compat masc_core masc_types unix yojson))
