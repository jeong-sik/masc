(include_subdirs no)

; Leaf, dependency-free: the exec shim links it too (through
; exec_ssh_protocol), and so do the two builds that make the static shim
; outside this dune project (scripts/remote-ssh/build-shim.sh runs this
; project's rules; scripts/build-shim-static.sh copies the modules).
(library
 (name masc_build_commit)
 (public_name masc.build_commit)
 (wrapped false)
 (modules build_commit_generated source_identity))

; Embed the git commit, its timestamp and the source identity together
; ("binary unknown" root fix; RFC host-and-shim-share-one-build-identity).
; The probe is a script rather than an inline command so the checkout path,
; the container fallback and the validation of the injected value stay
; readable; it carries its own reasoning. (universe) re-runs the probe every
; build; downstream recompiles only when the emitted values change.
; Sandboxing is disabled so git can ascend to the checkout being built. sh,
; not bash: the shim's Alpine builder runs this rule as well.
(rule
 (targets build_commit_generated.ml)
 (deps
  (sandbox none)
  (universe))
 (action
  (with-stdout-to
   %{targets}
   (run sh %{dep:probe-commit.sh}))))
