---
interface Props {
  lang?: 'en' | 'ko';
}

const { lang = 'en' } = Astro.props;
const isKo = lang === 'ko';

const t = {
  // Not the page title again -- the <h1> above already carries that sentence.
  // This line is for what the title leaves out.
  tagline: isKo
    ? "서버 하나, .masc 디렉터리 하나. 에이전트가 작업을 집어 들고 샌드박스에서 턴을 돌리면, 그 기록을 다음 에이전트가 읽습니다."
    : "One server, one .masc directory. An agent claims a task, runs its turns in a sandbox, and the next agent reads what it left.",
  // Was `./quickstart.sh`, which only exists in a source checkout -- the wrong
  // command for the reader this page is for. Installing is genuinely four
  // steps (pick a tag, download, read it, run it) and the Quickstart button
  // beside this carries them; what fits on one line is the command that opens
  // everything once installed.
  copyCommand: "masc --base-path ~/masc",
  copyCommandNote: isKo
    ? "설치 후 이 한 줄이면 UI 가 열리고 서버는 뒤에서 뜹니다."
    : "After installing, this one line opens the UI and starts the server behind it.",

  // Tabs for real screenshot. The label is the surface name in the TUI's own
  // ring, because that is the word a reader will press.
  tab1: isKo ? "개요" : "Overview",
  tab2: isKo ? "키퍼" : "Keepers",
  tab3: isKo ? "런타임" : "Runtime",
  tab4: isKo ? "승인" : "Approvals",
  tab5: isKo ? "활동" : "Activity",
  shotAlt1: isKo
    ? "MASC 개요 화면: 함대 상태 한 줄, 주의가 필요한 Keeper 목록, 작업 목록."
    : "MASC Overview surface: one fleet status line, the Keepers needing attention, and the task list.",
  shotAlt2: isKo
    ? "MASC Keepers 화면: Keeper 한 명당 한 줄로 상태, 오토부트, 샌드박스, 런타임, 맡은 작업."
    : "MASC Keepers surface: one row per Keeper with health, autoboot, sandbox, runtime and current task.",
  shotAlt3: isKo
    ? "MASC Runtime 화면: LLM 레인별 슬롯 순서와 카탈로그 시도 순서."
    : "MASC Runtime surface: each LLM lane's slot order and the catalog attempt order.",
  shotAlt4: isKo
    ? "MASC Approvals 화면: 사람의 판단을 기다리는 항목 큐."
    : "MASC Approvals surface: the queue of items waiting on a human decision.",
  shotAlt5: isKo
    ? "MASC Activity 화면: 모든 Keeper 의 도구 호출과 턴 경계를 최신순으로 흘리는 피드."
    : "MASC Activity surface: the newest-first feed of every Keeper's tool calls and turn boundaries.",
  screenCaption: isKo 
    ? "실제 터미널 런타임 캡처 (masc-tui · 2026-09-05 실측 133×28)" 
    : "Actual terminal capture from masc-tui (2026-09-05 live runtime 133×28)",

  // Invariants
  invariantsTag: isKo ? "핵심 기능" : "CAPABILITIES",
  invariantsTitle: isKo ? "MASC가 하는 일" : "What MASC does",

  card1Title: isKo ? "작업 선점 (Claim)" : "Task Claiming",
  card1Desc: isKo
    ? "작업을 한 에이전트가 claim하면 스토어가 다른 에이전트의 claim을 거절합니다. 소유권과 진행 상태가 공용 저장소에 남습니다."
    : "Once an agent claims a task, the store rejects any other claim. Ownership and progress stay in the shared store.",

  card2Title: isKo ? "단일 MCP 게이트웨이" : "Unified MCP Gateway",
  card2Desc: isKo
    ? "Claude Code, Cursor 같은 MCP 클라이언트가 :8935/mcp 엔드포인트로 접속합니다. masc mcp-config가 토큰과 설정 블록을 만들어 줍니다."
    : "MCP clients such as Claude Code and Cursor connect to the :8935/mcp endpoint; masc mcp-config mints the token and config block.",

  card3Title: isKo ? "장기 기억 (Memory OS)" : "Memory OS",
  card3Desc: isKo
    ? "Keeper가 학습한 사실을 저장하고 다음 턴에 다시 씁니다. 사실이 언제 회수되고 인용됐는지 사건으로 기록합니다."
    : "Facts a Keeper learns are stored and reused on later turns. Retrieval and citation land as recorded events.",

  card4Title: isKo ? "샌드박스 격리 & 오퍼레이터 승인" : "Sandbox Isolation & Operator Approvals",
  card4Desc: isKo
    ? "도구 실행을 Docker, MicroVM(apple_container), Remote SSH로 격리하고 고위험 명령은 Approvals 큐에서 승인을 대기합니다."
    : "Confines tool execution within Docker, MicroVM, or Remote SSH, pausing high-risk mutations in Approvals.",

  // Quickstart
  quickTag: isKo ? "빠른 시작" : "QUICKSTART",
  quickTitle: isKo ? "3단계로 즉시 실행" : "Up and Running in 3 Steps",
  step1: isKo ? "작업 공간 심기" : "Seed the workspace",
  step1Desc: isKo
    ? "설정 트리를 바이너리 안에서 꺼내 씁니다. 저장소를 받아본 적 없는 기계에서도 됩니다. install.sh 로 설치했다면 이미 끝나 있습니다."
    : "Writes the configuration tree out of the binary itself, so it works on a machine that never had a checkout. install.sh has already done this.",
  step2: isKo ? "켜기" : "Start it",
  step2Desc: isKo
    ? "터미널에서는 UI 가 열리고 서버는 그 뒤에서 뜹니다. 파이프나 systemd 아래에서는 같은 명령이 서버로 돕니다."
    : "In a terminal the UI opens and the server starts behind it. Under a pipe or a unit file the same command runs the server instead.",
  step3: isKo ? "MCP 클라이언트 연동" : "Connect an MCP client",
  step3Desc: isKo
    ? "masc mcp-config 가 토큰과 설정 블록을 만들어 줍니다. env, codex, claude-desktop 중에 고릅니다."
    : "masc mcp-config mints the token and the config block. Pick env, codex, or claude-desktop.",

  // Quick links
  docsTitle: isKo ? "문서 둘러보기" : "Documentation Matrix",
  docGetStarted: isKo ? "시작하기" : "Getting Started",
  docGetStartedDesc: isKo ? "개요, 빠른 시작, FAQ" : "Overview, Quickstart, FAQ",
  docGuides: isKo ? "사용 가이드" : "User Guides",
  docGuidesDesc: isKo ? "터미널 UI(TUI), Keeper 구동, MCP 연동" : "Terminal UI, Keepers, MCP clients",
  docOps: isKo ? "운영 가이드" : "Operations",
  docOpsDesc: isKo ? "로컬 Llama 연결, Docker 샌드박스, 문제 해결" : "Local models, Docker sandbox, troubleshooting",
  docArch: isKo ? "핵심 원리 & 설계 결정" : "Architecture & Decisions",
  docArchDesc: isKo ? "헌법 불변식, 장기 기억, 다중 모델 심의" : "Invariants, Memory OS, Multi-model deliberation",
};
---

<div class="eng-root">
  {/* TOP COMPACT MASTHEAD */}
  <header class="masthead">
    <div class="masthead-left">
      <div class="brand-row">
        <span class="brand-ver">v0.31.0</span>
        <span class="brand-sep">/</span>
        <span class="brand-tagline">{t.tagline}</span>
      </div>
    </div>
    <div class="masthead-right">
      <button class="quick-cmd" id="copy-install-cmd" type="button"
              aria-label={t.copyCommandNote}>
        <span class="cmd-dollar" aria-hidden="true">$</span>
        <code class="cmd-code">{t.copyCommand}</code>
        <span class="copy-badge">Copy</span>
      </button>
      <p class="quick-cmd-note">{t.copyCommandNote}</p>
      <a href={isKo ? "/ko/getting-started/quickstart/" : "/getting-started/quickstart/"} class="nav-link-btn">
        {isKo ? "빠른 시작 →" : "Quickstart →"}
      </a>
      <a href="https://github.com/jeong-sik/masc" target="_blank" rel="noreferrer" class="nav-link-dim">
        GitHub ↗
      </a>
    </div>
  </header>

  {/* REAL TERMINAL CAPTURE SHOWCASE (NO FAKE CSS TERMINAL) */}
  <section class="tui-showcase-section">
    <div class="tui-tab-bar">
      {/* A real tablist: the product is driven from a keyboard, and a strip of
          bare buttons that only answers a mouse reads as a contradiction.
          Arrow keys, Home and End move; only the selected tab is tabbable. */}
      <div class="tui-tabs" role="tablist" aria-label={t.screenCaption}>
        <button class="tui-tab active" role="tab" aria-selected="true" tabindex="0"
                data-img="/01-overview.png" data-alt={t.shotAlt1}>{t.tab1}</button>
        <button class="tui-tab" role="tab" aria-selected="false" tabindex="-1"
                data-img="/02-keepers.png" data-alt={t.shotAlt2}>{t.tab2}</button>
        <button class="tui-tab" role="tab" aria-selected="false" tabindex="-1"
                data-img="/03-lanes.png" data-alt={t.shotAlt3}>{t.tab3}</button>
        <button class="tui-tab" role="tab" aria-selected="false" tabindex="-1"
                data-img="/05-approvals.png" data-alt={t.shotAlt4}>{t.tab4}</button>
        <button class="tui-tab" role="tab" aria-selected="false" tabindex="-1"
                data-img="/06-activity.png" data-alt={t.shotAlt5}>{t.tab5}</button>
      </div>
      <span class="tui-caption">{t.screenCaption}</span>
    </div>

    {/* 2242x896 is what the capture is. Declaring 1920x1080 made the browser
        hold a 16:9 box and then jump to 2.5:1 when the file arrived. */}
    <div class="tui-frame">
      <img 
        id="tui-active-img" 
        src="/01-overview.png" 
        alt={t.shotAlt1}
        width="2242" 
        height="896" 
        loading="eager"
        decoding="async"
      />
    </div>
  </section>

  {/* Four capability cards */}
  <section class="sec-block">
    <div class="sec-hdr">
      <span class="sec-tag">{t.invariantsTag}</span>
      <h2 class="sec-title">{t.invariantsTitle}</h2>
    </div>

    <div class="inv-grid">
      <div class="inv-card">
        <div class="inv-head">
          <span class="inv-idx">01</span>
          <h3 class="inv-name">{t.card1Title}</h3>
        </div>
        <p class="inv-body">{t.card1Desc}</p>
        <pre class="inv-code"><code><span class="c-kw">match</span> Workspace_task.claim_task config ~agent_name ~task_id <span class="c-kw">with</span>
| <span class="c-ok">Ok</span> task -&gt; execute_turn ~task ()
| <span class="c-err">Error</span> (Held_by_other &#123; owner; _ &#125;) -&gt; yield_to_peer ~owner</code></pre>
      </div>

      <div class="inv-card">
        <div class="inv-head">
          <span class="inv-idx">02</span>
          <h3 class="inv-name">{t.card2Title}</h3>
        </div>
        <p class="inv-body">{t.card2Desc}</p>
        <div class="mcp-tags">
          <span class="tag-item">Claude Code</span>
          <span class="tag-item">Cursor IDE</span>
          <span class="tag-item">Codex</span>
          <span class="tag-item">Windsurf</span>
        </div>
      </div>

      <div class="inv-card">
        <div class="inv-head">
          <span class="inv-idx">03</span>
          <h3 class="inv-name">{t.card3Title}</h3>
        </div>
        <p class="inv-body">{t.card3Desc}</p>
        <div class="graph-pill">
          <span>Trigger</span> &rarr; <span class="pill-act">Decision</span> &rarr; <span>Outcome</span>
        </div>
      </div>

      <div class="inv-card">
        <div class="inv-head">
          <span class="inv-idx">04</span>
          <h3 class="inv-name">{t.card4Title}</h3>
        </div>
        <p class="inv-body">{t.card4Desc}</p>
        <div class="gate-strip">
          <span class="gate-lbl">APPROVAL QUEUE</span>
          <code>git push origin main --force</code>
          <span class="gate-act">Paused for operator</span>
        </div>
      </div>
    </div>
  </section>

  {/* 3 QUICK COMMANDS */}
  <section class="sec-block">
    <div class="sec-hdr">
      <span class="sec-tag">{t.quickTag}</span>
      <h2 class="sec-title">{t.quickTitle}</h2>
    </div>

    <div class="quick-grid">
      <div class="q-card">
        <div class="q-num">1</div>
        <div class="q-content">
          <h4>{t.step1}</h4>
          <p>{t.step1Desc}</p>
          <pre><code>$ masc init --base-path ~/masc</code></pre>
        </div>
      </div>
      <div class="q-card">
        <div class="q-num">2</div>
        <div class="q-content">
          <h4>{t.step2}</h4>
          <p>{t.step2Desc}</p>
          <pre><code>$ masc --base-path ~/masc</code></pre>
        </div>
      </div>
      <div class="q-card">
        <div class="q-num">3</div>
        <div class="q-content">
          <h4>{t.step3}</h4>
          <p>{t.step3Desc}</p>
          <pre><code>$ masc mcp-config --client claude-desktop</code></pre>
        </div>
      </div>
    </div>
  </section>


  {/* DOCUMENTATION MATRIX */}
  <section class="sec-block">
    <div class="sec-hdr">
      <span class="sec-tag">INDEX</span>
      <h2 class="sec-title">{t.docsTitle}</h2>
    </div>

    <div class="doc-matrix">
      <a href={isKo ? "/ko/getting-started/overview/" : "/getting-started/overview/"} class="doc-card">
        <span class="doc-card-tag">{t.docGetStarted} &rarr;</span>
        <span class="doc-card-desc">{t.docGetStartedDesc}</span>
      </a>
      <a href={isKo ? "/ko/guides/tui/" : "/guides/tui/"} class="doc-card">
        <span class="doc-card-tag">{t.docGuides} &rarr;</span>
        <span class="doc-card-desc">{t.docGuidesDesc}</span>
      </a>
      <a href={isKo ? "/ko/runbooks/llama-server/" : "/runbooks/llama-server/"} class="doc-card">
        <span class="doc-card-tag">{t.docOps} &rarr;</span>
        <span class="doc-card-desc">{t.docOpsDesc}</span>
      </a>
      <a href={isKo ? "/ko/architecture/constitution/" : "/architecture/constitution/"} class="doc-card">
        <span class="doc-card-tag">{t.docArch} &rarr;</span>
        <span class="doc-card-desc">{t.docArchDesc}</span>
      </a>
    </div>
  </section>
</div>

<script>
  // Real Screenshot Tab Switching
  const tabs = Array.from(document.querySelectorAll('.tui-tab')) as HTMLButtonElement[];
  const activeImg = document.getElementById('tui-active-img') as HTMLImageElement;

  // Fetch every frame up front. Each is a flat terminal capture that gzips
  // small, and without this the first press of a tab shows an empty frame
  // while the file is still on the wire.
  tabs.forEach(tab => {
    const src = tab.getAttribute('data-img');
    if (src) { const pre = new Image(); pre.src = src; }
  });

  const select = (tab: HTMLButtonElement, focus: boolean) => {
    tabs.forEach(t => {
      const on = t === tab;
      t.classList.toggle('active', on);
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
    });

    const imgSrc = tab.getAttribute('data-img');
    if (activeImg && imgSrc && activeImg.getAttribute('src') !== imgSrc) {
      // Fade through, rather than swapping under the reader's eye. The class
      // is dropped on load so a cached frame still lands at full opacity.
      activeImg.classList.add('swapping');
      const show = () => {
        activeImg.classList.remove('swapping');
        activeImg.removeEventListener('load', show);
      };
      activeImg.addEventListener('load', show);
      activeImg.src = imgSrc;
      activeImg.alt = tab.getAttribute('data-alt') || activeImg.alt;
    }

    if (focus) tab.focus();
  };

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab, false));
    tab.addEventListener('keydown', (event) => {
      const key = (event as KeyboardEvent).key;
      let next = -1;
      if (key === 'ArrowRight') next = (i + 1) % tabs.length;
      else if (key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
      else if (key === 'Home') next = 0;
      else if (key === 'End') next = tabs.length - 1;
      if (next < 0) return;
      event.preventDefault();
      select(tabs[next], true);
    });
  });

  // Copy to Clipboard
  const copyBox = document.getElementById('copy-install-cmd');
  if (copyBox) {
    copyBox.addEventListener('click', async () => {
      const code = copyBox.querySelector('.cmd-code')?.textContent || '';
      try {
        await navigator.clipboard.writeText(code);
        const badge = copyBox.querySelector('.copy-badge');
        if (badge) {
          badge.textContent = 'Copied!';
          setTimeout(() => { badge.textContent = 'Copy'; }, 2000);
        }
      } catch (err) {
        console.warn('Copy failed', err);
      }
    });
  }
</script>

<style>
  .eng-root {
    max-width: 1060px;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
    color: #f0e9dc;
    font-family: var(--sl-font-system, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
  }

  /* TOP COMPACT MASTHEAD */
  .masthead {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #221f1a;
    margin-bottom: 2rem;
  }

  .brand-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.875rem;
  }

  .brand-ver {
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.75rem;
    background: #1a1815;
    border: 1px solid #2a2520;
    color: #9c9589;
    padding: 1px 6px;
    border-radius: 3px;
  }

  .brand-sep {
    color: #3b352e;
  }

  .brand-tagline {
    color: #9c9589;
  }

  .masthead-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .quick-cmd {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: #141210;
    border: 1px solid #2a2520;
    border-radius: 4px;
    padding: 0.35rem 0.65rem;
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.8125rem;
    cursor: pointer;
    transition: border-color 0.15s;
  }

  .quick-cmd:hover {
    border-color: #d4a14a;
  }

  .cmd-dollar {
    color: #d4a14a;
    user-select: none;
  }

  .cmd-code {
    color: #f0e9dc;
    background: transparent !important;
    padding: 0 !important;
    border: none !important;
  }

  .copy-badge {
    font-size: 0.6875rem;
    color: #6e675d;
    margin-left: 0.3rem;
  }

  .nav-link-btn {
    background: #211e1a;
    color: #d4a14a !important;
    border: 1px solid #332d24;
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 0.4rem 0.75rem;
    border-radius: 4px;
    text-decoration: none !important;
    transition: all 0.15s;
  }

  .nav-link-btn:hover {
    background: #2b2721;
    border-color: #d4a14a;
  }

  .nav-link-dim {
    color: #6e675d !important;
    font-size: 0.8125rem;
    text-decoration: none !important;
  }

  .nav-link-dim:hover {
    color: #f0e9dc !important;
  }

  /* REAL TUI SHOWCASE */
  .tui-showcase-section {
    margin-bottom: 3.5rem;
  }

  .tui-tab-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .tui-tabs {
    display: flex;
    gap: 0.4rem;
  }

  .tui-tab {
    background: #141210;
    border: 1px solid #2a2520;
    color: #9c9589;
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.75rem;
    padding: 0.35rem 0.75rem;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s;
  }

  .tui-tab:hover {
    color: #f0e9dc;
    border-color: #3b352e;
  }

  .tui-tab.active {
    background: #211e1a;
    border-color: #d4a14a;
    color: #d4a14a;
    font-weight: 600;
  }

  .tui-caption {
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.6875rem;
    color: #6e675d;
  }

  .tui-frame {
    background: #000;
    border: 1px solid #2a2520;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6);
  }

  .tui-frame img {
    display: block;
    width: 100%;
    height: auto;
    /* The attributes now carry the capture's own 2242x896, so the box is
       reserved at the right shape and there is nothing to crop. `cover` here
       would only ever cut the terminal's edge columns off. */
    object-fit: contain;
    opacity: 1;
    transition: opacity 160ms ease;
  }

  .tui-frame img.swapping {
    opacity: 0.35;
  }

  .quick-cmd {
    /* It was a div with a title attribute: not reachable by keyboard and
       invisible to a screen reader. A button costs nothing and says what it is. */
    font: inherit;
    color: inherit;
    cursor: pointer;
  }

  .quick-cmd-note {
    margin: 0.4rem 0 0;
    font-size: 0.78rem;
    line-height: 1.5;
    opacity: 0.6;
    max-width: 42ch;
    /* Korean has no spaces inside a word, so the default break rule splits
       one mid-syllable ("뜹니 다"). keep-all breaks between words instead. */
    word-break: keep-all;
  }

  .quick-cmd:focus-visible,
  .tui-tab:focus-visible {
