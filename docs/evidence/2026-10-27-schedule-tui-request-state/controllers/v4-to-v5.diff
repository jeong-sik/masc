+def initial_input_readiness(base, tui_pid):
+    """Existing structured state-application facts, never terminal text/paint."""
+    log_root=base/'.masc/logs/tui'
+    if not log_root.exists():return None
+    sessions=[p for p in log_root.iterdir() if p.name.startswith('session-'+str(tui_pid)+'-')]
+    if not sessions:return None
+    if len(sessions)!=1 or sessions[0].is_symlink() or not sessions[0].is_dir():
+        raise Incomplete('owned TUI structured session identity ambiguous')
+    session=sessions[0];records=[];inputs=[]
+    for path in sorted(session.glob('system_log_*.jsonl')):
+        if path.is_symlink() or not path.is_file():raise Incomplete('TUI log is not an owned regular file')
+        raw=path.read_bytes();complete=raw.rsplit(b'\n',1)[0] if b'\n' in raw else b''
+        inputs.append({'path':str(path),'observed_prefix_bytes':len(raw),
+            'observed_prefix_sha256':hashlib.sha256(raw).hexdigest(),
+            'scope':'Snapshot prefix of live append-only log; full private log not copied.'})
+        for line_no,line in enumerate(complete.splitlines(),1):
+            try:record=json.loads(line)
+            except (ValueError,UnicodeError):raise Incomplete('complete structured TUI log line malformed')
+            if not isinstance(record,dict) or type(record.get('seq')) is not int:
+                raise Incomplete('structured TUI log sequence unavailable')
+            records.append((record['seq'],path,line_no,record))
+    records.sort(key=lambda row:row[0])
+    if len({row[0] for row in records})!=len(records):raise Incomplete('structured TUI sequence duplicated')
+    initialized=False;captures={};startup=None
+    def selected(seq,path,line_no,event):
+        return {'seq':seq,'path':str(path),'line':line_no,'event':event}
+    def nanoseconds(value):
+        if not isinstance(value,str) or not value.isascii() or not value.isdigit():
+            raise Incomplete('TUI semantic timestamp malformed')
+        return int(value)
+    for seq,path,line_no,record in records:
+        if record.get('source')!='structured':continue
+        details=record.get('details')
+        if isinstance(details,dict) and details.get('event')=='tui_observation_store':
+            if details.get('phase')=='initialized' and details.get('pid')==tui_pid and details.get('directory')==str(session):
+                initialized=True
+        if record.get('module')!='Transport':continue
+        message=record.get('message')
+        if not isinstance(message,str):continue
+        if message.startswith('tui_local_read='):
+            try:event=json.loads(message[len('tui_local_read='):])
+            except ValueError:raise Incomplete('local-read semantic JSON malformed')
+            if not isinstance(event,dict) or event.get('schema')!='masc.tui-local-read-observation/v2':
+                raise Incomplete('local-read semantic schema unavailable')
+            capture=event.get('capture_id');phase=event.get('phase')
+            if not isinstance(capture,str):raise Incomplete('local-read capture identity unavailable')
+            if phase=='requested' and event.get('pid')==tui_pid and event.get('source')=='keepers':
+                if capture in captures:raise Incomplete('local-read requested identity duplicated')
+                captures[capture]={'requested':selected(seq,path,line_no,event)}
+            elif capture in captures and phase in ['ui_admission','ui_application','retired']:
+                if phase=='retired':raise Incomplete('initial Keeper application was retired before readiness')
+                expected='accepted' if phase=='ui_admission' else 'applied'
+                if event.get('outcome')!=expected:raise Incomplete('initial Keeper admission/application not successful')
+                if phase in captures[capture]:raise Incomplete('local-read semantic phase duplicated')
+                captures[capture][phase]=selected(seq,path,line_no,event)
+        elif message.startswith('tui_startup_observation='):
+            try:event=json.loads(message[len('tui_startup_observation='):])
+            except ValueError:raise Incomplete('startup semantic JSON malformed')
+            if not isinstance(event,dict) or event.get('pid')!=tui_pid:continue
+            caller=event.get('caller_observed')
+            if isinstance(caller,dict) and caller.get('value')!='returned':
+                raise Incomplete('initial terminal capture did not return successfully')
+            if event.get('phase')=='capabilities_applied':
+                applied=event.get('capabilities_applied');decoder=event.get('decoder_installed_ns')
+                if not isinstance(applied,dict) or not isinstance(caller,dict):
+                    raise Incomplete('startup application lacks decoder/caller facts')
+                if not (nanoseconds(event.get('dispatched_ns'))<=nanoseconds(decoder)<=
+                        nanoseconds(applied.get('at_ns'))<=nanoseconds(event.get('observed_ns'))):
+                    raise Incomplete('startup semantic ordering mismatch')
+                startup=selected(seq,path,line_no,{k:event[k] for k in
+                    ['phase','pid','dispatched_ns','observed_ns','decoder_installed_ns','capabilities_applied','caller_observed']})
+    if not initialized or startup is None:return None
