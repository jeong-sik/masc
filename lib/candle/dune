(include_subdirs no)

;; Candle ledger (RFC-goal-candle-ledger, RFC step 3): the reward currency's
;; ledger event types and the strict codec that reads and writes their JSONL
;; rows. Pure: no file, clock or global state. Nothing here reads Goal, Task or
;; keeper stores; callers pass typed values in.

(library
 (name masc_candle)
 (public_name masc.masc_candle)
 (wrapped false)
 ; Closed variants must remain exhaustive; unused declarations are build errors.
 (flags
  (:standard -w +4 -w +33 -w +37))
 (libraries masc_core masc.keeper_portrait yojson ptime zarith))
