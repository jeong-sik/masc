(include_subdirs no)

; Its own library rather than another module in [masc]: the handler needs
; nothing from that library, and the structure ratchet counts every module
; added to it as debt the extraction is meant to pay down.
(library
 (name masc_tool_spawn)
 (public_name masc.tool_spawn)
 (wrapped false)
 (modules tool_spawn)
 (flags
  (:standard -w +4 -w +33))
 (libraries
  masc.tool_types
  masc.masc_core
  masc.string_util
  masc.time_compat
  masc.masc_process
  masc.tool_schemas
  eio
  unix
  yojson))
