{
  "type": "object",
  "description": "Questions for the operator, each backed by verbatim quotes from the supplied material.",
  "properties": {
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1,
            "description": "A short name for what the question is about, reused across sessions."
          },
          "header": {
            "type": "string",
            "minLength": 1,
            "description": "A label of a few words."
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "description": "The question as the operator reads it. It must not reveal the answer or cite a source."
          },
          "mode": {
            "type": "string",
            "enum": [
              "single",
              "multi",
              "text"
            ],
            "description": "single or multi for a choice question; text for a question answered in words."
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "choice_id": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "choice_id",
                "label"
              ],
              "additionalProperties": false
            },
            "description": "At least two for single or multi; empty for text."
          },
          "key": {
            "type": "array",
            "description": "The choice ids that are correct: exactly one for single, at least one for multi, empty for text.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rubric": {
            "type": "array",
            "description": "For text, the points a correct answer must state, each following from a quote; empty for single or multi.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "board_post",
                    "board_comment",
                    "repo_file",
                    "commit",
                    "wiki_page",
                    "pr",
                    "pr_comment"
                  ]
                },
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "pin": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The pin of a material record, copied exactly."
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Text copied byte for byte from that record. The key must follow from it."
                }
              },
              "required": [
                "kind",
                "source_id",
                "pin",
                "quote"
              ],
              "additionalProperties": false
            }
          },
          "reask_of": {
            "type": "array",
            "maxItems": 1,
            "description": "Empty for a new item, or the one item_id this question asks again.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "topic",
          "header",
          "prompt",
          "mode",
          "choices",
          "key",
          "rubric",
          "sources",
          "reask_of"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "questions"
  ],
  "additionalProperties": false
}
