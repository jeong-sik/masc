;; Phase 1 SSH remote execution lane (spec §4.2): remote shim installed on
;; SSH endpoints as the fixed remote command.  Decodes one framed request
;; from stdin, supervises the payload (setsid + pdeathsig, process-group
;; SIGTERM/grace/SIGKILL), and appends the result trailer to stderr.  Kept
;; dependency-minimal (exec_ssh_protocol + unix) so scripts/build-shim-static.sh
;; can produce a small static musl Linux binary.

(executable
 (name masc_exec_shim)
 (modules masc_exec_shim)
 (public_name masc-exec-shim)
 (package masc)
 (libraries exec_shim))

(executable
 (name masc_exec_ssh_bootstrap)
 (modules masc_exec_ssh_bootstrap)
 (public_name masc-exec-ssh-bootstrap)
 (package masc)
 (libraries masc masc.runtime masc_workspace fs_compat cmdliner unix))

;; RFC-0374 capability probe runner.  Answers "can runtime R reach tool T"
