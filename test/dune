(env
 (_
  ; Test assertions match the one case they check and fail on the rest, so
  ; listing every other constructor would only bury the assertion.
  (flags
   (:standard -w -4))
  (env-vars
   ; Ignore shell-level workspace overrides so tests stay isolated in temp dirs.
   ; Prevent inherited shell MASC_BASE_PATH from binding tests to real
   ; workspace state. Tests that need a base path pass it explicitly.
   (MASC_BASE_PATH "")
   ; Avoid non-deterministic external network calls during unit tests.
   (ZAI_API_KEY "")
   ; A key exported in the shell would turn TypeSafe AI Jev on in every
   ; board-attention test; the cases that need it set it themselves.
   (TYPESAFEAI_API_KEY "")
   (MASC_KEEPER_SANDBOX_PREFLIGHT_ENABLED false))))

