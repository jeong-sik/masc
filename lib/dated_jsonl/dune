(include_subdirs no)

(library
 (name dated_jsonl)
 (public_name masc.dated_jsonl)
 ; Warning 4 (fragile pattern match), 33 (unused open) and 37 (unused constructor) on.
 ; Warning 32 used to be switched off here to grandfather pre-existing
 ; unused values; the sweep finds none, so the exemption is gone and the
 ; root dune's applies. The flags live in the single (flags ...)
 ; stanza so the effective warning mask is not split across
 ; (flags)/(ocamlc_flags)/(ocamlopt_flags).
 (flags
  (:standard -w +33 -w +4 -w +37))
 (preprocess
  (pps ppx_enumerate))
 (libraries
  fs_compat
  jsonl_writer
  masc_log
  masc_core
  masc.config
  masc.config_dir_resolver
  otel_metric_store
  unix
  yojson))
