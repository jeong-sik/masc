(* Typed payload schemas for Agent Core events relayed to Dashboard SSE. The
   envelope around a payload is built by [Keeper_event_bridge.wrap_event]. *)

(* Observation topics are one closed contract shared by the server's commit
   notifications and the Dashboard's mounted readers. No rows, credentials or
   original request bodies travel in these invalidations. *)
type dashboard_observation_topic = [
  | Logs <json name="logs">
  | Health <json name="health">
  | Runtime_probe <json name="runtime_probe">
  | Attribution <json name="attribution">
  | Keeper_composite <json name="keeper_composite">
  | Keeper_runtime_trace <json name="keeper_runtime_trace">
  | Keeper_sandbox <json name="keeper_sandbox">
  | Keeper_turns <json name="keeper_turns">
  | Keeper_memory_health <json name="keeper_memory_health">
  | Runtime_resolved <json name="runtime_resolved">
  | Model_metrics <json name="model_metrics">
  | Runtime_observables <json name="runtime_observables">
  | Scheduled_automation <json name="scheduled_automation">
  | Tools <json name="tools">
  | Tool_metrics <json name="tool_metrics">
  | Skills <json name="skills">
  | Async_requests <json name="async_requests">
  | Skill_usage <json name="skill_usage">
  | Skill_activations <json name="skill_activations">
  | Telemetry <json name="telemetry">
  | Published_artifacts <json name="published_artifacts">
  | Artifact_checks <json name="artifact_checks">
  | Verification_requests <json name="verification_requests">
  | Verification_specs <json name="verification_specs">
  | Tlc_results <json name="tlc_results">
  | Activity <json name="activity">
  | Ide_presence <json name="ide_presence">
  | Ide_events <json name="ide_events">
  | Gate <json name="gate">
  | Gate_tool_events <json name="gate_tool_events">
  | Chat_operation <json name="chat_operation">
]

type dashboard_observation_operation = {
  keeper_name: string;
  operation_id: string;
}

type dashboard_observation_scope = [
  | Workspace <json name="workspace">
  | Keeper <json name="keeper"> of string
  | Operation <json name="operation"> of dashboard_observation_operation
]

type dashboard_observation_changed_payload = {
  topic: dashboard_observation_topic;
  scope: dashboard_observation_scope;
}

type agent_started_payload = {
  agent_name: string;
  task_id: string;
}

type tool_called_payload = {
  agent_name: string;
  tool_name: string;
}

type tool_completed_payload = {
  agent_name: string;
  tool_name: string;
}

type turn_started_payload = {
  agent_name: string;
  turn: int;
}

type turn_completed_payload = {
  agent_name: string;
  turn: int;
}

type turn_ready_payload = {
  agent_name: string;
  turn: int;
  count: int;
  names_hash: string;
  tool_names: string list;
}

type handoff_requested_payload = {
  from_agent: string;
  to_agent: string;
  reason: string;
}

type handoff_completed_payload = {
  from_agent: string;
  to_agent: string;
  elapsed_s: float;
}

type content_replacement_replaced_payload = {
  tool_use_id: string;
  preview: string;
  original_chars: int;
  seen_count_after: int;
}

type content_replacement_kept_payload = {
  tool_use_id: string;
  seen_count_after: int;
}

type agent_completed_payload = {
  agent_name: string;
  task_id: string;
  elapsed_s: float;
}

type agent_yielded_payload = {
  agent_name: string;
  task_id: string;
  turn: int;
  elapsed_s: float;
}

(* Variant-specific typed error details remain opaque to the shared reader. *)
type json_value <ocaml module="Yojson.Safe" t="t"> = abstract

type agent_input_required_payload = {
  agent_name: string;
  task_id: string;
  elapsed_s: float;
  request_id: string;
  participant_name: string nullable;
  question: string;
  schema: json_value nullable;
  timeout_s: float nullable;
  created_at: float;
}

type agent_failed_payload = {
  agent_name: string;
  task_id: string;
  elapsed_s: float;
  error: string;
  error_domain: string;
  error_code: string;
  error_retryable: bool;
  error_detail: json_value;
}
