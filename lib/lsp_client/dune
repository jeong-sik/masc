(include_subdirs no)

; An LSP client is not an HTTP-server concern. These two modules sat in
; [masc_server] because its WebSocket proxy was their only caller, which put
; them above [masc] in the dependency order — so nothing in [masc], including
; the Keeper tool dispatch in lib/keeper, could reach a language server. This
; library sits below both, so the proxy and a Keeper surface can share one
; client (RFC a-language-server-the-keeper-can-ask §3.2).
(library
 (name masc_lsp_client)
 (public_name masc.lsp_client)
 (wrapped false)
 (flags
  (:standard -w +33))
 (libraries
  masc.ide_memo
  masc.agent_observation
  masc.masc_eio_context
  masc.fs_compat
  masc.masc_core
  masc.masc_log
  masc.masc_process
  cstruct
  eio
  eio.unix
  fmt
  unix
  uri
  yojson))
