+        if not (ordered[0]['seq']<ordered[1]['seq']<ordered[2]['seq']):
+            raise Incomplete('Keeper application semantic sequence mismatch')
+        stamps=[nanoseconds(row['event'].get('at_ns')) for row in ordered]
+        if stamps!=sorted(stamps):raise Incomplete('Keeper application semantic time ordering mismatch')
+        return {'tui_pid':tui_pid,'session':str(session),'capture_id':capture,
