(include_subdirs no)

;; The parts of Candle that run inside the server (RFC-goal-candle-ledger 3):
;; whether Candle is on right now, the steps that write a Goal's Snapshot and
;; PayoutOwed when the verifier passes it and the operator confirms it, and the
;; worker that prepares the payout.
;;
;; This is the only Candle library that knows about a Goal. masc_candle,
;; masc_candle_store and masc_candle_config know nothing of it, and masc_goal
;; knows nothing of Candle: the dependency runs from here to the Goal libraries.

(library
 (name masc_candle_runtime)
 (public_name masc.masc_candle_runtime)
 (wrapped false)
 (flags
  (:standard -w +4 -w +33 -w +37))
 (libraries
  masc_candle
  masc.keeper_portrait
  masc_candle_store
  masc_candle_config
  masc_goal
  masc_workspace
  masc_types
  masc_keeper_registry
  masc_config_dir_resolver
  masc_log
  time_compat
  eio
  ptime))
