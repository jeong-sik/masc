(include_subdirs no)

(library
 (name embedded_config)
 (public_name masc.embedded_config)
 (modules embedded_config embedded_skills embedded_setup)
 ; RFC-0071 §3.4 Phase 5 ratchet: warning 4 (fragile pattern match) on. + unused-value ratchet (warning 32)
 ; embedded_config.ml is generated by ocaml-crunch -m plain (simple
 ; string lookup table) — no fragile matches.
 (flags
  (:standard -w +4 -w +33 -w +37))
 (wrapped false))

; Generate embedded_config.ml from the repo's config/ tree at build time.
; -m plain mode produces:
;   val read : string -> string option
;   val file_list : string list
; The path under config/ becomes the lookup key (e.g. "runtime.toml",
; "keepers/sangsu.toml"). This makes the release binary self-seeding for
; first-run, removing the network dependency from scripts/install.sh.

(rule
 (target embedded_setup.ml)
 (deps ../../scripts/embed-setup.py ../../scripts/install-runtime-setup.py)
 (action
  (with-stdout-to %{target}
   (run python3 %{dep:../../scripts/embed-setup.py}
    %{dep:../../scripts/install-runtime-setup.py}))))

(rule
 (target embedded_config.ml)
 (deps
  (source_tree ../../config))
 (action
  (with-stdout-to
   %{target}
   (run ocaml-crunch -m plain ../../config))))

; First-party Skills ship independently of the runtime config tree. Bootstrap
; materializes complete missing packages in the default declared Skill source.
(rule
 (target embedded_skills.ml)
 (deps (source_tree ../../skills))
 (action
  (with-stdout-to %{target}
   (run ocaml-crunch -m plain ../../skills))))
