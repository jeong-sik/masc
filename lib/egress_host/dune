; The egress allowlist's trust boundary. Deliberately depends on nothing:
; the matcher is the piece an allowlist bypass goes through, so it stays
; readable end to end and unit-testable without a workspace.
(library
 (name masc_egress_host)
 (public_name masc.egress_host)
 (wrapped false)
 (flags
  (:standard -w +4 -w +33))
 (modules egress_host))
