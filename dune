(dirs
 (:standard
  \
  .worktrees
  worktrees
  _build_codex_trpg
  archive
  dashboard_bonsai))

; Warning 32 (unused value declaration) is set here, once, for the whole
; tree. It used to be decided per library: of 121 stanzas under lib/, 84
; opted in and 37 did not, so an unreachable value in any of those 37
; produced no signal at all, and a wrapper ladder could grow four rungs deep
; before anyone could see it. Setting it centrally means the build stops the
; moment a value loses its last caller, in the same edit that removed it.
; scripts/ci/check-ocaml-compile-authority.sh asserts both flags stay here.
(env
 (dev
  (flags
   (:standard -w +32 -warn-error +a)))
 (release
  (flags
   (:standard -w +32 -warn-error +a))))

(install
 (package masc)
 (section bin)
 (files
  (scripts/check-runtime-deployment-preflight.sh as
   masc-check-runtime-deployment-preflight)))

; Build-time check: reject OPERATOR_TODO placeholders in source code.
; This prevents deployment of code with unresolved placeholders.
(rule
 (alias all)
 (deps
  (source_tree .))
 (action
  (run scripts/ci/check-persona-profile-placeholders.sh .)))
