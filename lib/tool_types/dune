; Tool_args + Tool_result shared types, as a leaf sub-library outside
; parent masc, so sub-libraries can use them without a sub-lib -> parent
; dependency.
;
; Typed model content uses the leaf llm_provider types; no Agent Core runtime
; dependency is introduced. (Tool_args.mli's Tool_local_runtime_core reference
; is a single OCamldoc cross-reference comment, not a code dep).
; (wrapped false) keeps bare `Tool_args` / `Tool_result` so all
; 1156 external refs (Tool_args 161 bare + 4 wrapped, Tool_result
; 969 bare + 22 wrapped) need only the 26 wrapped refs sed'd to bare.

(include_subdirs no)

(library
 (name masc_tool_types)
 (public_name masc.tool_types)
 (wrapped false)
 (libraries yojson unix masc_log masc_core eio time_compat llm_provider masc.masc_tool_blob_store)
 (preprocess
  (pps ppx_deriving_yojson ppx_deriving.show)))
